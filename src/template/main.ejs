<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= htmlWebpackPlugin.options.title %></title>
  <meta name="description" content="Straightforward exercise API pricing. Compare Free, Lite, Plus, and Max plans for exercise images, metadata, muscle mapping, and 30 languages.">
  <meta name="theme-color" content="#faf9f6">
  <% if (noindex) { %><meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer"><% } %>
  <link rel="canonical" href="https://letstag.app<%= canonicalPath %>">
  <link rel="icon" href="/icon/favicon.ico">
  <link rel="apple-touch-icon" href="/icon/apple-touch-icon.png">
  <meta property="og:title" content="<%= htmlWebpackPlugin.options.title %>">
  <meta property="og:description" content="Exercise data for your next great app. Plans from free to enterprise scale.">
  <meta property="og:image" content="https://letstag.app/img/logo_512.webp">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://letstag.app<%= canonicalPath %>">
</head>
<body style="margin: 0; background: #faf9f6;">
  <div id="root"></div>
  <noscript>Please enable JavaScript to view pricing or securely update your payment details.</noscript>
</body>
</html>
