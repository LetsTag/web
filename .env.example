# Public Paddle client-side token; never use a server-side API key here.
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=production

# Paddle price IDs (pri_…) for each billing option.
PADDLE_PRICE_FREE_MONTHLY=
PADDLE_PRICE_FREE_ANNUAL=
PADDLE_PRICE_LITE_MONTHLY=
PADDLE_PRICE_LITE_ANNUAL=
PADDLE_PRICE_PLUS_MONTHLY=
PADDLE_PRICE_PLUS_ANNUAL=
PADDLE_PRICE_MAX_MONTHLY=
PADDLE_PRICE_MAX_ANNUAL=

# Public Google OAuth client ID and HTTPS origin of the workout API.
# Defaults: http://localhost:8000 in development, https://api.letstag.app in production.
GOOGLE_CLIENT_ID=586854344993-7smlttnkmpc3isf6auvo95nkiegi7n9s.apps.googleusercontent.com
